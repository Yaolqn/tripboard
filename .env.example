# TripBoard environment variables
# Copy to .env.local for local development. Never commit .env.local.

# Absolute URL of the deployed site (canonical URLs & Open Graph).
# Example: https://tripboard.vercel.app
NEXT_PUBLIC_SITE_URL=

# Supabase project (https://supabase.com) — create a project, then copy
# Project URL and anon public key from Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Amap Web Service POI search (server-only; never use NEXT_PUBLIC_ here).
# Create credentials in the Amap console. The secret is optional unless
# signature verification is enabled for the Web Service key.
AMAP_WEB_SERVICE_KEY=
AMAP_WEB_SERVICE_SECRET=
