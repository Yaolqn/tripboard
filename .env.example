# TripBoard environment variables
# Copy to .env.local for local development. Never commit .env.local.

# Absolute URL of the deployed site (canonical URLs & Open Graph).
# Example: https://tripboard.vercel.app
NEXT_PUBLIC_SITE_URL=

# Supabase project (https://supabase.com) — create a project, then copy
# Project URL and anon public key from Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Amap JS API 2.0 browser key (restrict it with a domain whitelist).
NEXT_PUBLIC_AMAP_JS_KEY=
# JS API security code. Configure it locally or in the deployment platform;
# never commit the actual value.
NEXT_PUBLIC_AMAP_SECURITY_CODE=

# Amap Web Service POI search key (server-only; never use NEXT_PUBLIC_ here).
AMAP_WEB_SERVICE_KEY=
